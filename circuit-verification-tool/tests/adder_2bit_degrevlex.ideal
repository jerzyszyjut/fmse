# 2-bit ripple-carry adder, s = a + b; degrevlex, every gate output larger than its inputs
vars s2 v1 u1 s1 t1 c1 s0 a1 a0 b1 b0
order degrevlex
spec 4*s2 + 2*s1 + s0 - ((2*a1 + a0) + (2*b1 + b0))
-s0 + a0 + b0 - 2*a0*b0
-c1 + a0*b0
-t1 + a1 + b1 - 2*a1*b1
-s1 + t1 + c1 - 2*t1*c1
-u1 + a1*b1
-v1 + t1*c1
-s2 + u1 + v1 - u1*v1
a0^2 - a0
a1^2 - a1
b0^2 - b0
b1^2 - b1
